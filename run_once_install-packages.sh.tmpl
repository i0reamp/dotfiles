#!/bin/bash
# chezmoi:template: leftDelimiter={{, rightDelimiter=}}
# Bootstrap: install required packages

set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
{{ if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}

install_if_missing() {
    if ! command -v "$1" &>/dev/null; then
        echo "Installing $2..."
        $3
    else
        echo "$1 already installed"
    fi
}

# sing-box
if ! command -v sing-box &>/dev/null; then
    echo "Installing sing-box..."
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL https://sing-box.app/gpg.key | sudo tee /etc/apt/keyrings/sagernet.asc >/dev/null
    sudo chmod a+r /etc/apt/keyrings/sagernet.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/sagernet.asc] https://deb.sagernet.org/ * *" | sudo tee /etc/apt/sources.list.d/sagernet.list >/dev/null
    sudo apt-get update -qq -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/sagernet.list -o Dir::Etc::sourceparts=/dev/null
    sudo apt-get install -y -qq sing-box
else
    echo "sing-box already installed"
fi

# Core packages
for pkg in rofi grim slurp wl-copy swaylock swayidle waybar brightnessctl wlsunset; do
    if ! command -v "$pkg" &>/dev/null; then
        sudo apt-get install -y -qq "$pkg" 2>/dev/null || echo "Warning: $pkg not found in repos"
    fi
done

# CLI tools
for pkg in ripgrep fd-find bat jq yq fzf tree htop cliphist sshfs; do
    dpkg -s "${pkg}" &>/dev/null || sudo apt-get install -y -qq "$pkg" 2>/dev/null || echo "Warning: $pkg not found"
done
# symlinks for Ubuntu-renamed binaries
[ -x /usr/bin/fdfind ] && ln -sf /usr/bin/fdfind ~/.local/bin/fd 2>/dev/null
[ -x /usr/bin/batcat ] && ln -sf /usr/bin/batcat ~/.local/bin/bat 2>/dev/null

# Screenshot OCR
for pkg in tesseract-ocr tesseract-ocr-rus; do
    dpkg -s "$pkg" &>/dev/null || sudo apt-get install -y -qq "$pkg" 2>/dev/null
done

# Autotiling for sway
if ! command -v autotiling &>/dev/null; then
    pip3 install --user --break-system-packages autotiling 2>/dev/null || true
fi

# Wayland screen sharing portal
dpkg -s xdg-desktop-portal-wlr &>/dev/null || sudo apt-get install -y -qq xdg-desktop-portal-wlr 2>/dev/null

# PipeWire audio utils
dpkg -s pulseaudio-utils &>/dev/null || sudo apt-get install -y -qq pulseaudio-utils 2>/dev/null

{{ end -}}
{{ end -}}
